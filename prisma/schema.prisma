// 50 notifications
model Notification {
  id                String              @id @default(uuid()) @db.Char(36)
  event             NotificationEvent
  channel           NotificationChannel
  recipientUserId   String?             @map("recipient_user_id") @db.Char(36)
  recipientAddress  String              @map("recipient_address") @db.VarChar(254)
  templateId        String?             @map("template_id") @db.Char(36)
  entityType        String?             @map("entity_type") @db.VarChar(50)
  entityId          String?             @map("entity_id") @db.Char(36)
  dedupeKey         String              @unique @map("dedupe_key") @db.VarChar(191)
  payload           Json?
  status            NotificationStatus  @default(QUEUED)
  attemptCount      Int                 @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?           @map("next_attempt_at") @db.DateTime(3)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(191)
  resendOfId        String?             @map("resend_of_id") @db.Char(36)
  triggeredById     String?             @map("triggered_by_id") @db.Char(36)
  createdAt         DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  recipient User?                 @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  template  NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resendOf  Notification?         @relation("NotificationResend", fields: [resendOfId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  resends   Notification[]        @relation("NotificationResend")
  logs      NotificationLog[]

  @@index([status, nextAttemptAt], map: "ix_notifications_dispatch")
  @@index([recipientUserId, createdAt], map: "ix_notifications_recipient")
  @@index([entityType, entityId], map: "ix_notifications_entity")
  @@map("notifications")
}

