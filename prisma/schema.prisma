  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([shipmentId, dedupeHash], map: "uq_tracking_dedupe")
  @@index([shipmentId, eventAt], map: "ix_tracking_shipment_time")
  @@map("shipment_tracking_events")
}

// 34 payments
model Payment {
  id                String        @id @default(uuid()) @db.Char(36)
  orderId           String        @map("order_id") @db.Char(36)
  attemptNo         Int           @default(1) @map("attempt_no")
  paymentMethod     PaymentMethod @map("payment_method")
  status            PaymentStatus @default(PENDING)
  provider          String?       @db.VarChar(30)
  providerOrderId   String?       @map("provider_order_id") @db.VarChar(100)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(100)
  amount            Decimal       @db.Decimal(12, 2)
  amountRefunded    Decimal       @default(0) @map("amount_refunded") @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  instrumentType    String?       @map("instrument_type") @db.VarChar(30)
  failureCode       String?       @map("failure_code") @db.VarChar(60)
  failureReason     String?       @map("failure_reason") @db.VarChar(500)
  authorizedAt      DateTime?     @map("authorized_at") @db.DateTime(3)
  capturedAt        DateTime?     @map("captured_at") @db.DateTime(3)
  failedAt          DateTime?     @map("failed_at") @db.DateTime(3)
  expiresAt         DateTime?     @map("expires_at") @db.DateTime(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@unique([orderId, attemptNo], map: "uq_payments_order_attempt")
  @@index([status, createdAt], map: "ix_payments_status_time")
  @@map("payments")
}

// 35 payment_transactions
model PaymentTransaction {
  id                String         @id @default(uuid()) @db.Char(36)
  paymentId         String         @map("payment_id") @db.Char(36)
  refundId          String?        @map("refund_id") @db.Char(36)
  type              PaymentTxnType
  provider          String?        @db.VarChar(30)
  providerEventId   String?        @map("provider_event_id") @db.VarChar(100)
  providerReference String?        @map("provider_reference") @db.VarChar(100)
  providerStatus    String?        @map("provider_status") @db.VarChar(40)
  amount            Decimal?       @db.Decimal(12, 2)
  signatureVerified Boolean        @default(false) @map("signature_verified")
  httpStatus        Int?           @map("http_status")
  errorCode         String?        @map("error_code") @db.VarChar(60)
  errorMessage      String?        @map("error_message") @db.VarChar(500)
  requestPayload    Json?          @map("request_payload")
  responsePayload   Json?          @map("response_payload")
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund  Refund? @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId, createdAt], map: "ix_payment_txn_payment_time")
  @@index([refundId], map: "ix_payment_txn_refund")
  @@map("payment_transactions")
}

// 36 refunds
model Refund {
  id               String       @id @default(uuid()) @db.Char(36)
  refundNumber     String       @unique @map("refund_number") @db.VarChar(20)
  orderId          String       @map("order_id") @db.Char(36)
  paymentId        String?      @map("payment_id") @db.Char(36)
  status           RefundStatus @default(REQUESTED)
  method           RefundMethod @default(ORIGINAL_PAYMENT_METHOD)
  reasonCode       String       @map("reason_code") @db.VarChar(40)
  reasonText       String?      @map("reason_text") @db.VarChar(1000)
  itemsAmount      Decimal      @default(0) @map("items_amount") @db.Decimal(12, 2)
  shippingAmount   Decimal      @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  amount           Decimal      @db.Decimal(12, 2)
  taxableValue     Decimal      @default(0) @map("taxable_value") @db.Decimal(12, 2)
  taxAmount        Decimal      @default(0) @map("tax_amount") @db.Decimal(12, 2)
  restock          Boolean      @default(false)
  requestedByType  ActorType    @map("requested_by_type")
  requestedById    String?      @map("requested_by_id") @db.Char(36)
  approvedById     String?      @map("approved_by_id") @db.Char(36)
  approvedAt       DateTime?    @map("approved_at") @db.DateTime(3)
  rejectedById     String?      @map("rejected_by_id") @db.Char(36)
  rejectedAt       DateTime?    @map("rejected_at") @db.DateTime(3)
  rejectionReason  String?      @map("rejection_reason") @db.VarChar(500)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(100)
  payoutReference  String?      @map("payout_reference") @db.VarChar(100)
  processingAt     DateTime?    @map("processing_at") @db.DateTime(3)
  completedAt      DateTime?    @map("completed_at") @db.DateTime(3)
  failedAt         DateTime?    @map("failed_at") @db.DateTime(3)
  failureReason    String?      @map("failure_reason") @db.VarChar(500)
  retryCount       Int          @default(0) @map("retry_count")
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment         Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items           RefundItem[]
  paymentTxns     PaymentTransaction[]
  inventoryTxns   InventoryTransaction[]
  invoiceRecords  InvoiceRecord[]
  taxTransactions TaxTransaction[]

  @@index([orderId], map: "ix_refunds_order")
  @@index([status, createdAt], map: "ix_refunds_status_time")
  @@index([completedAt], map: "ix_refunds_completed")
  @@map("refunds")
}

// 37 refund_items
model RefundItem {
  id           String  @id @default(uuid()) @db.Char(36)
  refundId     String  @map("refund_id") @db.Char(36)
  orderItemId  String  @map("order_item_id") @db.Char(36)
  quantity     Int
  amount       Decimal @db.Decimal(12, 2)
  taxableValue Decimal @default(0) @map("taxable_value") @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([refundId, orderItemId], map: "uq_refund_items_refund_line")
  @@map("refund_items")
}

// 42 coupons
model Coupon {
  id                         String       @id @default(uuid()) @db.Char(36)
  code                       String       @db.VarChar(32)
  codeNormalized             String       @unique @map("code_normalized") @db.VarChar(32)
  description                String?      @db.VarChar(500)
  discountType               DiscountType @map("discount_type")
  discountValue              Decimal      @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount          Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  minOrderValue              Decimal?     @map("min_order_value") @db.Decimal(12, 2)
  startsAt                   DateTime?    @map("starts_at") @db.DateTime(3)
  expiresAt                  DateTime?    @map("expires_at") @db.DateTime(3)
  usageLimitEnabled          Boolean      @default(false) @map("usage_limit_enabled")
  usageLimit                 Int?         @map("usage_limit")
  perCustomerLimit           Int?         @map("per_customer_limit")
  usedCount                  Int          @default(0) @map("used_count")
  isFirstOrderOnly           Boolean      @default(false) @map("is_first_order_only")
  isCombinableWithPromotions Boolean      @default(false) @map("is_combinable_with_promotions")
  isPublic                   Boolean      @default(false) @map("is_public") // [P3-EXT OQ-102]
  status                     CouponStatus @default(ACTIVE)
  createdAt                  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                  DateTime?    @map("deleted_at") @db.DateTime(3)

  applicabilities CouponApplicability[]
  usage           CouponUsage[]
  carts           Cart[]
  orders          Order[]

  @@map("coupons")
}

// 43 coupon_applicability
model CouponApplicability {
  id           String           @id @default(uuid()) @db.Char(36)
  couponId     String           @map("coupon_id") @db.Char(36)
  ruleType     CouponRuleType   @map("rule_type")
  targetType   CouponTargetType @map("target_type")
  productId    String?          @map("product_id") @db.Char(36)
  categoryId   String?          @map("category_id") @db.Char(36)
  brandId      String?          @map("brand_id") @db.Char(36)
  collectionId String?          @map("collection_id") @db.Char(36)

  coupon     Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  product    Product?    @relation("CouponProductTarget", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category   Category?   @relation("CouponCategoryTarget", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand      Brand?      @relation("CouponBrandTarget", fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collection Collection? @relation("CouponCollectionTarget", fields: [collectionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("coupon_applicability")
}

// 44 coupon_usage
model CouponUsage {
  id             String            @id @default(uuid()) @db.Char(36)
  couponId       String            @map("coupon_id") @db.Char(36)
  userId         String            @map("user_id") @db.Char(36)
  orderId        String            @unique @map("order_id") @db.Char(36)
  status         CouponUsageStatus @default(RESERVED)
  discountAmount Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  reservedAt     DateTime?         @map("reserved_at") @db.DateTime(3)
  redeemedAt     DateTime?         @map("redeemed_at") @db.DateTime(3)
  releasedAt     DateTime?         @map("released_at") @db.DateTime(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([couponId, userId], map: "ix_coupon_usage_coupon_user")
  @@map("coupon_usage")
}

// 45 promotions
model Promotion {
  id                String          @id @default(uuid()) @db.Char(36)
  name              String          @db.VarChar(150)
  nameNormalized    String          @unique @map("name_normalized") @db.VarChar(150)
  scope             PromotionScope
  discountType      DiscountType    @map("discount_type")
  discountValue     Decimal         @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?        @map("max_discount_amount") @db.Decimal(12, 2)
  startsAt          DateTime?       @map("starts_at") @db.DateTime(3)
  endsAt            DateTime?       @map("ends_at") @db.DateTime(3)
