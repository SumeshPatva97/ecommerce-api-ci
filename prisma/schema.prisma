// 39 shipments
model Shipment {
  id               String         @id @default(uuid()) @db.Char(36)
  shipmentNumber   String         @unique @map("shipment_number") @db.VarChar(20)
  orderId          String         @map("order_id") @db.Char(36)
  shippingMethodId String?        @map("shipping_method_id") @db.Char(36)
  status           ShipmentStatus @default(PENDING)
  provider         String?        @db.VarChar(30)
  awbNumber        String?        @map("awb_number") @db.VarChar(100)
  shippedAt        DateTime?      @map("shipped_at") @db.DateTime(3)
