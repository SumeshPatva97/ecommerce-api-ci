  barcode               String?  @db.VarChar(64)
  attributesSnapshot    Json     @map("attributes_snapshot")
  imageUrl              String?  @map("image_url") @db.VarChar(500)
  categoryIdSnapshot    String   @map("category_id_snapshot") @db.Char(36)
  categoryNameSnapshot  String   @map("category_name_snapshot") @db.VarChar(120)
  brandIdSnapshot       String?  @map("brand_id_snapshot") @db.Char(36)
  brandNameSnapshot     String?  @map("brand_name_snapshot") @db.VarChar(120)
  hsnCode               String   @map("hsn_code") @db.VarChar(8)
  quantity              Int
  mrp                   Decimal  @db.Decimal(12, 2)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(12, 2)
  promotionId           String?  @map("promotion_id") @db.Char(36)
  promotionNameSnapshot String?  @map("promotion_name_snapshot") @db.VarChar(150)
  promotionDiscount     Decimal  @default(0) @map("promotion_discount") @db.Decimal(12, 2)
