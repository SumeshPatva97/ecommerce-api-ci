// 1 users
model User {
  id                 String      @id @default(uuid()) @db.Char(36)
  accountType        AccountType @map("account_type")
  email              String      @db.VarChar(254)
  emailNormalized    String      @unique @map("email_normalized") @db.VarChar(254)
  phone              String?     @unique @db.VarChar(16)
  passwordHash       String?     @map("password_hash") @db.VarChar(255)
  passwordChangedAt  DateTime?   @map("password_changed_at") @db.DateTime(3)
  firstName          String      @map("first_name") @db.VarChar(80)
  lastName           String?     @map("last_name") @db.VarChar(80)
  status             UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt    DateTime?   @map("email_verified_at") @db.DateTime(3)
  phoneVerifiedAt    DateTime?   @map("phone_verified_at") @db.DateTime(3)
  isSuperadmin       Boolean     @default(false) @map("is_superadmin")
  mfaEnabled         Boolean     @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?     @map("mfa_secret_encrypted") @db.VarChar(255)
  lastLoginAt        DateTime?   @map("last_login_at") @db.DateTime(3)
  lastLoginIp        String?     @map("last_login_ip") @db.VarChar(45)
  failedLoginCount   Int         @default(0) @map("failed_login_count")
  lockedUntil        DateTime?   @map("locked_until") @db.DateTime(3)
  anonymizedAt       DateTime?   @map("anonymized_at") @db.DateTime(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?   @map("deleted_at") @db.DateTime(3)
  // [ACTOR]/[SOFT] actor refs are soft scalars (no FK) except where explicit below
  createdById        String?     @map("created_by_id") @db.Char(36)
  updatedById        String?     @map("updated_by_id") @db.Char(36)
  deletedById        String?     @map("deleted_by_id") @db.Char(36)

  addresses           UserAddress[]
  refreshTokens       RefreshToken[]
  verificationTokens  VerificationToken[]
  notificationPrefs   NotificationPreference[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  carts               Cart[]
  wishlists           Wishlist[]
  recentlyViewed      RecentlyViewedProduct[]
  orders              Order[]                  @relation("OrderCustomer")
  reviews             Review[]
  couponUsage         CouponUsage[]
  reportExports       ReportExport[]
  idempotencyKeys     IdempotencyKey[]
  assignedRoles       UserRole[]               @relation("UserRoleAssignedBy") // [P3-21] back-relation of UserRole.assignedBy (role assignments made by this user)
  notifications       Notification[]           @relation("NotificationRecipient") // [P3-21] back-relation of Notification.recipient

  @@index([accountType, status, createdAt], map: "ix_users_type_status_created")
  @@index([lastLoginAt], map: "ix_users_last_login")
  @@index([isSuperadmin, status], map: "ix_users_superadmin")
  @@map("users")
}

// 2 roles
model Role {
  id             String   @id @default(uuid()) @db.Char(36)
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(100)
  nameNormalized String   @unique @map("name_normalized") @db.VarChar(100)
  description    String?  @db.VarChar(500)
  isSystem       Boolean  @default(false) @map("is_system")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdById    String?  @map("created_by_id") @db.Char(36)
  updatedById    String?  @map("updated_by_id") @db.Char(36)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([isActive], map: "ix_roles_active")
  @@map("roles")
}

// 3 permissions
model Permission {
  id           String   @id @default(uuid()) @db.Char(36)
  code         String   @unique @db.VarChar(100)
  module       String   @db.VarChar(50)
  action       String   @db.VarChar(20)
  description  String   @db.VarChar(255)
  isCritical   Boolean  @default(false) @map("is_critical")
  sortOrder    Int      @default(0) @map("sort_order")
  isDeprecated Boolean  @default(false) @map("is_deprecated")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@unique([module, action], map: "uq_permissions_module_action")
  @@map("permissions")
}

// 4 user_roles
model UserRole {
  userId       String   @map("user_id") @db.Char(36)
  roleId       String   @map("role_id") @db.Char(36)
  assignedById String?  @map("assigned_by_id") @db.Char(36)
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId], map: "ix_user_roles_role")
  @@map("user_roles")
}

// 5 role_permissions
model RolePermission {
  roleId       String   @map("role_id") @db.Char(36)
  permissionId String   @map("permission_id") @db.Char(36)
  grantedById  String?  @map("granted_by_id") @db.Char(36)
  grantedAt    DateTime @default(now()) @map("granted_at") @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permissions_permission")
  @@map("role_permissions")
}

// 6 user_permission_overrides
model UserPermissionOverride {
  id           String                   @id @default(uuid()) @db.Char(36)
  userId       String                   @map("user_id") @db.Char(36)
  permissionId String                   @map("permission_id") @db.Char(36)
  effect       PermissionOverrideEffect @default(DENY)
  reason       String?                  @db.VarChar(500)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  createdById  String?                  @map("created_by_id") @db.Char(36)
  updatedById  String?                  @map("updated_by_id") @db.Char(36)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, permissionId], map: "uq_upo_user_permission")
  @@index([permissionId], map: "ix_upo_permission")
  @@map("user_permission_overrides")
}

// 7 user_addresses
model UserAddress {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String   @map("user_id") @db.Char(36)
  label       String?  @db.VarChar(30)
  fullName    String   @map("full_name") @db.VarChar(120)
  phone       String   @db.VarChar(16)
  line1       String   @db.VarChar(200)
  line2       String?  @db.VarChar(200)
  landmark    String?  @db.VarChar(120)
  city        String   @db.VarChar(100)
  district    String?  @db.VarChar(100)
  stateCode   String   @map("state_code") @db.Char(2)
  postalCode  String   @map("postal_code") @db.Char(6)
  countryCode String   @default("IN") @map("country_code") @db.Char(2)
  companyName String?  @map("company_name") @db.VarChar(150)
  gstin       String?  @db.VarChar(15)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  state State @relation(fields: [stateCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, isDefault], map: "ix_user_addresses_user")
  @@map("user_addresses")
}

// 8 refresh_tokens
model RefreshToken {
  id                String        @id @default(uuid()) @db.Char(36)
  userId            String        @map("user_id") @db.Char(36)
  familyId          String        @map("family_id") @db.Char(36)
  tokenHash         String        @unique @map("token_hash") @db.Char(64)
  audience          TokenAudience
  replacedById      String?       @map("replaced_by_id") @db.Char(36)
  issuedAt          DateTime      @default(now()) @map("issued_at") @db.DateTime(3)
  expiresAt         DateTime      @map("expires_at") @db.DateTime(3)
  absoluteExpiresAt DateTime      @map("absolute_expires_at") @db.DateTime(3)
  lastUsedAt        DateTime?     @map("last_used_at") @db.DateTime(3)
  revokedAt         DateTime?     @map("revoked_at") @db.DateTime(3)
  revokedReason     String?       @map("revoked_reason") @db.VarChar(40)
  ipAddress         String?       @map("ip_address") @db.VarChar(45)
  userAgent         String?       @map("user_agent") @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId, revokedAt], map: "ix_refresh_tokens_user_active")
  @@index([familyId], map: "ix_refresh_tokens_family")
  @@index([expiresAt], map: "ix_refresh_tokens_expires")
  @@map("refresh_tokens")
}

// 9 verification_tokens
model VerificationToken {
  id            String              @id @default(uuid()) @db.Char(36)
  userId        String              @map("user_id") @db.Char(36)
  purpose       VerificationPurpose
  channel       NotificationChannel
  target        String              @db.VarChar(254)
  tokenHash     String              @unique @map("token_hash") @db.Char(64)
  attemptCount  Int                 @default(0) @map("attempt_count")
  maxAttempts   Int                 @default(5) @map("max_attempts")
  expiresAt     DateTime            @map("expires_at") @db.DateTime(3)
  consumedAt    DateTime?           @map("consumed_at") @db.DateTime(3)
  invalidatedAt DateTime?           @map("invalidated_at") @db.DateTime(3)
  ipAddress     String?             @map("ip_address") @db.VarChar(45)
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, purpose, createdAt], map: "ix_verification_tokens_user_purpose")
  @@index([expiresAt], map: "ix_verification_tokens_expires")
  @@map("verification_tokens")
}

// 10 notification_preferences
model NotificationPreference {
  id                 String               @id @default(uuid()) @db.Char(36)
  userId             String               @map("user_id") @db.Char(36)
  channel            NotificationChannel
  category           NotificationCategory
  isOptedIn          Boolean              @map("is_opted_in")
  consentSource      String?              @map("consent_source") @db.VarChar(40)
  consentTextVersion String?              @map("consent_text_version") @db.VarChar(20)
  consentedAt        DateTime?            @map("consented_at") @db.DateTime(3)
  optedOutAt         DateTime?            @map("opted_out_at") @db.DateTime(3)
  ipAddress          String?              @map("ip_address") @db.VarChar(45)
  createdAt          DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, channel, category], map: "uq_notification_prefs")
  @@map("notification_preferences")
}

// 11 categories
model Category {
  id             String    @id @default(uuid()) @db.Char(36)
  parentId       String?   @map("parent_id") @db.Char(36)
  name           String    @db.VarChar(120)
  nameNormalized String    @map("name_normalized") @db.VarChar(120)
  slug           String    @unique @db.VarChar(160)
  path           String    @db.VarChar(120)
  depth          Int       @db.TinyInt
  description    String?   @db.Text
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  imagePublicId  String?   @map("image_public_id") @db.VarChar(255)
  bannerImageUrl String?   @map("banner_image_url") @db.VarChar(500)
  bannerImagePid String?   @map("banner_image_public_id") @db.VarChar(255)
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  showInMenu     Boolean   @default(true) @map("show_in_menu")
  seoTitle       String?   @map("seo_title") @db.VarChar(160)
  seoDescription String?   @map("seo_description") @db.VarChar(320)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)
  createdById    String?   @map("created_by_id") @db.Char(36)
  updatedById    String?   @map("updated_by_id") @db.Char(36)
  deletedById    String?   @map("deleted_by_id") @db.Char(36)

  parent                Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children              Category[]             @relation("CategoryTree")
  products              Product[]
  categoryAttrs         CategoryAttribute[]
  promotionCategories   PromotionCategory[]
  couponApplicabilities CouponApplicability[]  @relation("CouponCategoryTarget")
  banners               Banner[]
  cmsBlocks             CmsBlock[]
  productTaxAssignments ProductTaxAssignment[]

  @@index([parentId, sortOrder], map: "ix_categories_parent_sort")
  @@map("categories")
}

// 12 category_attributes
model CategoryAttribute {
  categoryId           String   @map("category_id") @db.Char(36)
  attributeId          String   @map("attribute_id") @db.Char(36)
  isRequired           Boolean  @default(false) @map("is_required")
  isVariantAxisDefault Boolean  @default(false) @map("is_variant_axis_default")
  inheritToChildren    Boolean  @default(true) @map("inherit_to_children")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([categoryId, attributeId])
  @@index([attributeId], map: "ix_category_attributes_attr")
  @@map("category_attributes")
}

// 13 brands
model Brand {
  id             String    @id @default(uuid()) @db.Char(36)
  name           String    @db.VarChar(120)
  nameNormalized String    @unique @map("name_normalized") @db.VarChar(120)
  slug           String    @unique @db.VarChar(160)
  description    String?   @db.Text
  logoUrl        String?   @map("logo_url") @db.VarChar(500)
  logoPublicId   String?   @map("logo_public_id") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  isFeatured     Boolean   @default(false) @map("is_featured")
  sortOrder      Int       @default(0) @map("sort_order")
  seoTitle       String?   @map("seo_title") @db.VarChar(160)
  seoDescription String?   @map("seo_description") @db.VarChar(320)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  products              Product[]
  promotionBrands       PromotionBrand[]
  couponApplicabilities CouponApplicability[] @relation("CouponBrandTarget")

  @@map("brands")
}

// 14 collections
model Collection {
  id             String    @id @default(uuid()) @db.Char(36)
  name           String    @db.VarChar(120)
  nameNormalized String    @unique @map("name_normalized") @db.VarChar(120)
  slug           String    @unique @db.VarChar(160)
  description    String?   @db.Text
  bannerImageUrl String?   @map("banner_image_url") @db.VarChar(500)
  bannerImagePid String?   @map("banner_image_public_id") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  isFeatured     Boolean   @default(false) @map("is_featured")
  startsAt       DateTime? @map("starts_at") @db.DateTime(3)
  endsAt         DateTime? @map("ends_at") @db.DateTime(3)
  sortOrder      Int       @default(0) @map("sort_order")
  seoTitle       String?   @map("seo_title") @db.VarChar(160)
  seoDescription String?   @map("seo_description") @db.VarChar(320)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)

  products              CollectionProduct[]
  promotionCollections  PromotionCollection[]
  couponApplicabilities CouponApplicability[] @relation("CouponCollectionTarget")

  @@map("collections")
}

// 15 collection_products
model CollectionProduct {
  collectionId String   @map("collection_id") @db.Char(36)
  productId    String   @map("product_id") @db.Char(36)
  sortOrder    Int      @default(0) @map("sort_order")
  addedById    String?  @map("added_by_id") @db.Char(36)
  addedAt      DateTime @default(now()) @map("added_at") @db.DateTime(3)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([collectionId, productId])
  @@index([productId], map: "ix_collection_products_product")
  @@map("collection_products")
}

// 16 products
model Product {
  id                  String        @id @default(uuid()) @db.Char(36)
  productType         ProductType   @map("product_type")
  name                String        @db.VarChar(200)
  nameNormalized      String        @map("name_normalized") @db.VarChar(200)
  slug                String        @unique @db.VarChar(160)
  categoryId          String        @map("category_id") @db.Char(36)
  brandId             String?       @map("brand_id") @db.Char(36)
  shortDescription    String?       @map("short_description") @db.VarChar(500)
  description         String?       @db.MediumText
  careInstructions    String?       @map("care_instructions") @db.Text
  searchKeywords      String?       @map("search_keywords") @db.VarChar(500)
  status              ProductStatus @default(DRAFT)
  isFeatured          Boolean       @default(false) @map("is_featured")
  isNewArrival        Boolean       @default(false) @map("is_new_arrival")
  isBestSellerPinned  Boolean       @default(false) @map("is_best_seller_pinned")
  publishedAt         DateTime?     @map("published_at") @db.DateTime(3)
  hsnCode             String?       @map("hsn_code") @db.VarChar(8)
  minSellingPrice     Decimal?      @map("min_selling_price") @db.Decimal(12, 2)
  maxSellingPrice     Decimal?      @map("max_selling_price") @db.Decimal(12, 2)
  maxDiscountPercent  Decimal       @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  isInStock           Boolean       @default(false) @map("is_in_stock")
  avgRating           Decimal       @default(0) @map("avg_rating") @db.Decimal(3, 2)
  reviewCount         Int           @default(0) @map("review_count")
  totalSold           Int           @default(0) @map("total_sold")
  countryOfOrigin     String?       @map("country_of_origin") @db.VarChar(80) // [P3-EXT OQ-98]
  manufacturerName    String?       @map("manufacturer_name") @db.VarChar(150) // [P3-EXT OQ-98]
  manufacturerAddress String?       @map("manufacturer_address") @db.Text // [P3-EXT OQ-98]
  importerName        String?       @map("importer_name") @db.VarChar(150) // [P3-EXT OQ-98]
  importerAddress     String?       @map("importer_address") @db.Text // [P3-EXT OQ-98]
  seoTitle            String?       @map("seo_title") @db.VarChar(160)
  seoDescription      String?       @map("seo_description") @db.VarChar(320)
  createdAt           DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime?     @map("deleted_at") @db.DateTime(3)
  createdById         String?       @map("created_by_id") @db.Char(36)
  updatedById         String?       @map("updated_by_id") @db.Char(36)
  deletedById         String?       @map("deleted_by_id") @db.Char(36)

  category              Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brand                 Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hsn                   HsnCode?                @relation(fields: [hsnCode], references: [hsnCode], onDelete: Restrict, onUpdate: Restrict)
  variants              ProductVariant[]
  images                ProductImage[]
  attributeValues       ProductAttributeValue[]
  collections           CollectionProduct[]
  wishlistItems         WishlistItem[]
  recentlyViewed        RecentlyViewedProduct[]
  reviews               Review[]
  taxAssignments        ProductTaxAssignment[]
  promotionProducts     PromotionProduct[]
  couponApplicabilities CouponApplicability[]   @relation("CouponProductTarget")
  orderItems            OrderItem[]

  @@unique([categoryId, nameNormalized], map: "uq_products_category_name") // [ASSUMPTION OQ-04]
  @@index([status, categoryId, publishedAt], map: "ix_products_listing_cat")
  @@index([status, minSellingPrice], map: "ix_products_listing_price")
  @@index([status, totalSold], map: "ix_products_listing_sold")
  @@index([status, avgRating], map: "ix_products_listing_rating")
  @@index([brandId, status], map: "ix_products_brand")
  @@index([status, isFeatured, publishedAt], map: "ix_products_featured")
  @@index([hsnCode], map: "ix_products_hsn")
  @@map("products")
}

// 17 product_images
model ProductImage {
  id                 String    @id @default(uuid()) @db.Char(36)
  productId          String    @map("product_id") @db.Char(36)
  variantId          String?   @map("variant_id") @db.Char(36)
  cloudinaryPublicId String    @map("cloudinary_public_id") @db.VarChar(255)
  url                String    @db.VarChar(500)
  altText            String?   @map("alt_text") @db.VarChar(200)
  width              Int?
  height             Int?
  format             String?   @db.VarChar(10)
  bytes              Int?
  sortOrder          Int       @default(0) @map("sort_order")
  isPrimary          Boolean   @default(false) @map("is_primary")
  mediaType          MediaType @default(IMAGE) @map("media_type") // [P3-EXT R-23]
  videoUrl           String?   @map("video_url") @db.VarChar(500)
  videoPublicId      String?   @map("video_public_id") @db.VarChar(255)
  posterPublicId     String?   @map("poster_public_id") @db.VarChar(255)
  durationSeconds    Int?      @map("duration_seconds")
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdById        String?   @map("created_by_id") @db.Char(36)
  updatedById        String?   @map("updated_by_id") @db.Char(36)

  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([productId, cloudinaryPublicId], map: "uq_product_images_public_id")
  @@index([productId, variantId, sortOrder], map: "ix_product_images_gallery")
  @@index([variantId], map: "ix_product_images_variant")
  @@map("product_images")
}

// 18 product_variants
model ProductVariant {
  id             String        @id @default(uuid()) @db.Char(36)
  productId      String        @map("product_id") @db.Char(36)
  sku            String        @unique @db.VarChar(32)
  barcode        String?       @unique @db.VarChar(64)
  name           String        @db.VarChar(200)
  combinationKey String        @map("combination_key") @db.VarChar(400)
  mrp            Decimal       @db.Decimal(12, 2)
  sellingPrice   Decimal       @map("selling_price") @db.Decimal(12, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  costPrice      Decimal?      @map("cost_price") @db.Decimal(12, 2)
  weightGrams    Decimal?      @map("weight_grams") @db.Decimal(10, 3)
  lengthMm       Int?          @map("length_mm")
  widthMm        Int?          @map("width_mm")
  heightMm       Int?          @map("height_mm")
  status         VariantStatus @default(ACTIVE)
  isDefault      Boolean       @default(false) @map("is_default")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?     @map("deleted_at") @db.DateTime(3)
  createdById    String?       @map("created_by_id") @db.Char(36)
  updatedById    String?       @map("updated_by_id") @db.Char(36)
  deletedById    String?       @map("deleted_by_id") @db.Char(36)

  product       Product                 @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventory     Inventory?
  images        ProductImage[]
  variantValues VariantAttributeValue[]
  inventoryTxns InventoryTransaction[]
  reservations  StockReservation[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@unique([id, productId], map: "uq_product_variants_id_product") // supporting key for SQL composite FK (product_images same-product integrity)
  @@unique([productId, combinationKey], map: "uq_product_variants_combination")
  @@index([productId, status, sortOrder], map: "ix_product_variants_product")
  @@index([status, sellingPrice], map: "ix_product_variants_price")
  @@map("product_variants")
}

// 19 attributes
model Attribute {
  id             String               @id @default(uuid()) @db.Char(36)
  name           String               @db.VarChar(80)
  nameNormalized String               @unique @map("name_normalized") @db.VarChar(80)
  code           String               @unique @db.VarChar(50)
  displayType    AttributeDisplayType @default(BUTTON) @map("display_type")
  isVariantAxis  Boolean              @default(false) @map("is_variant_axis")
  isFilterable   Boolean              @default(false) @map("is_filterable")
  isVisibleOnPdp Boolean              @default(true) @map("is_visible_on_pdp")
  unit           String?              @db.VarChar(20)
  sortOrder      Int                  @default(0) @map("sort_order")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?            @map("deleted_at") @db.DateTime(3)

  values        AttributeValue[]
  categoryAttrs CategoryAttribute[]
  variantValues VariantAttributeValue[]
  productValues ProductAttributeValue[]

  @@map("attributes")
}

// 20 attribute_values
model AttributeValue {
  id              String    @id @default(uuid()) @db.Char(36)
  attributeId     String    @map("attribute_id") @db.Char(36)
  value           String    @db.VarChar(100)
  valueNormalized String    @map("value_normalized") @db.VarChar(100)
  slug            String    @db.VarChar(120)
  swatchHex       String?   @map("swatch_hex") @db.Char(7)
  swatchImageUrl  String?   @map("swatch_image_url") @db.VarChar(500)
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(3)

  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variantValues VariantAttributeValue[]
  productValues ProductAttributeValue[]

  @@unique([attributeId, valueNormalized], map: "uq_attribute_values_attr_value")
  @@unique([attributeId, slug], map: "uq_attribute_values_attr_slug")
  @@unique([attributeId, id], map: "uq_attribute_values_attr_id") // composite FK target
  @@index([attributeId, isActive, sortOrder], map: "ix_attribute_values_sort")
  @@map("attribute_values")
}

// 21 variant_attribute_values
model VariantAttributeValue {
  variantId        String   @map("variant_id") @db.Char(36)
  attributeId      String   @map("attribute_id") @db.Char(36)
  attributeValueId String   @map("attribute_value_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([variantId, attributeId])
  @@index([attributeValueId, variantId], map: "ix_vav_value_variant")
  @@map("variant_attribute_values")
}

// 22 product_attribute_values
model ProductAttributeValue {
  productId        String   @map("product_id") @db.Char(36)
  attributeValueId String   @map("attribute_value_id") @db.Char(36)
  attributeId      String   @map("attribute_id") @db.Char(36)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([productId, attributeValueId])
  @@index([attributeValueId, productId], map: "ix_pav_value_product")
  @@index([attributeId, productId], map: "ix_pav_attr_product")
  @@map("product_attribute_values")
}

// 23 inventory
model Inventory {
  variantId         String    @id @map("variant_id") @db.Char(36)
  quantityOnHand    Int       @default(0) @map("quantity_on_hand")
  quantityReserved  Int       @default(0) @map("quantity_reserved")
  // quantityAvailable: STORED generated (on_hand - reserved) — SQL-only, read-only
  lowStockThreshold Int?      @map("low_stock_threshold")
  lowStockAlertedAt DateTime? @map("low_stock_alerted_at") @db.DateTime(3)
  lastMovementAt    DateTime? @map("last_movement_at") @db.DateTime(3)
  version           Int       @default(0)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  updatedById       String?   @map("updated_by_id") @db.Char(36)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("inventory")
}

// 24 inventory_transactions
model InventoryTransaction {
  id                 String           @id @default(uuid()) @db.Char(36)
  variantId          String           @map("variant_id") @db.Char(36)
  type               InventoryTxnType
  onHandDelta        Int              @default(0) @map("on_hand_delta")
  reservedDelta      Int              @default(0) @map("reserved_delta")
  onHandAfter        Int              @map("on_hand_after")
  reservedAfter      Int              @map("reserved_after")
  reasonCode         String?          @map("reason_code") @db.VarChar(40)
  note               String?          @db.VarChar(500)
  unitCost           Decimal?         @map("unit_cost") @db.Decimal(12, 2)
  orderId            String?          @map("order_id") @db.Char(36)
  refundId           String?          @map("refund_id") @db.Char(36)
  stockReservationId String?          @map("stock_reservation_id") @db.Char(36)
  batchId            String?          @map("batch_id") @db.Char(36)
  createdById        String?          @map("created_by_id") @db.Char(36)
  createdAt          DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order            Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund           Refund?           @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stockReservation StockReservation? @relation(fields: [stockReservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([variantId, createdAt], map: "ix_inv_txn_variant_time")
  @@index([type, createdAt], map: "ix_inv_txn_type_time")
  @@index([orderId], map: "ix_inv_txn_order")
  @@index([refundId], map: "ix_inv_txn_refund")
  @@index([stockReservationId], map: "ix_inv_txn_reservation")
  @@index([batchId], map: "ix_inv_txn_batch")
  @@map("inventory_transactions")
}

// 25 stock_reservations
model StockReservation {
  id            String            @id @default(uuid()) @db.Char(36)
  orderId       String            @map("order_id") @db.Char(36)
  variantId     String            @map("variant_id") @db.Char(36)
  quantity      Int
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime          @map("expires_at") @db.DateTime(3)
  committedAt   DateTime?         @map("committed_at") @db.DateTime(3)
  releasedAt    DateTime?         @map("released_at") @db.DateTime(3)
  releaseReason String?           @map("release_reason") @db.VarChar(40)
  createdAt     DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant       ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inventoryTxns InventoryTransaction[]

  @@unique([orderId, variantId], map: "uq_stock_reservations_order_variant")
  @@index([status, expiresAt], map: "ix_stock_reservations_sweep")
  @@index([variantId, status], map: "ix_stock_reservations_variant")
  @@map("stock_reservations")
}

// 26 carts
model Cart {
  id               String     @id @default(uuid()) @db.Char(36)
  userId           String     @map("user_id") @db.Char(36)
  status           CartStatus @default(ACTIVE)
  couponId         String?    @map("coupon_id") @db.Char(36)
  couponCode       String?    @map("coupon_code") @db.VarChar(32)
  convertedOrderId String?    @map("converted_order_id") @db.Char(36)
  lastActivityAt   DateTime   @default(now()) @map("last_activity_at") @db.DateTime(3)
  abandonedAt      DateTime?  @map("abandoned_at") @db.DateTime(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  coupon         Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  convertedOrder Order?     @relation("ConvertedOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  items          CartItem[]

