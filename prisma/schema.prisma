  @@index([orderId], map: "ix_shipments_order")
  @@map("shipments")
}

// 40 shipment_items
model ShipmentItem {
  shipmentId  String @map("shipment_id") @db.Char(36)
  orderItemId String @map("order_item_id") @db.Char(36)
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([shipmentId, orderItemId])
  @@map("shipment_items")
}

// 41 shipment_tracking_events
model ShipmentTrackingEvent {
  id             String         @id @default(uuid()) @db.Char(36)
  shipmentId     String         @map("shipment_id") @db.Char(36)
  mappedStatus   ShipmentStatus @map("mapped_status")
  providerStatus String?        @map("provider_status") @db.VarChar(100)
  message        String?        @db.VarChar(500)
  location       String?        @db.VarChar(200)
  dedupeHash     String         @map("dedupe_hash") @db.Char(64)
