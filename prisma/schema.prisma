  taxableValue          Decimal  @map("taxable_value") @db.Decimal(12, 2)
  taxRate               Decimal  @map("tax_rate") @db.Decimal(5, 2)
  cgstRate              Decimal  @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount            Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate              Decimal  @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount            Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  utgstRate             Decimal  @default(0) @map("utgst_rate") @db.Decimal(5, 2)
  utgstAmount           Decimal  @default(0) @map("utgst_amount") @db.Decimal(12, 2)
  igstRate              Decimal  @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount            Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  taxAmount             Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal             Decimal  @map("line_total") @db.Decimal(12, 2)
  taxRateIdSnapshot     String?  @map("tax_rate_id_snapshot") @db.Char(36)
  costPriceSnapshot     Decimal? @map("cost_price_snapshot") @db.Decimal(12, 2)
  weightGramsSnapshot   Decimal? @map("weight_grams_snapshot") @db.Decimal(10, 3)
  quantityShipped       Int      @default(0) @map("quantity_shipped")
  quantityCancelled     Int      @default(0) @map("quantity_cancelled")
  quantityRefunded      Int      @default(0) @map("quantity_refunded")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant         ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  promotion       Promotion?       @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refundItems     RefundItem[]
  shipmentItems   ShipmentItem[]
  reviews         Review[]
  taxTransactions TaxTransaction[]

  @@unique([orderId, lineNo], map: "uq_order_items_line")
  @@unique([orderId, variantId], map: "uq_order_items_variant")
  @@index([variantId, createdAt], map: "ix_order_items_variant_time")
  @@index([productId, createdAt], map: "ix_order_items_product_time")
  @@map("order_items")
}

// 33 order_status_history
model OrderStatusHistory {
  id                String                @id @default(uuid()) @db.Char(36)
