// 57 tax_transactions
model TaxTransaction {
  id                     String       @id @default(uuid()) @db.Char(36)
  invoiceRecordId        String       @map("invoice_record_id") @db.Char(36)
  documentType           InvoiceType  @map("document_type")
  orderId                String       @map("order_id") @db.Char(36)
  orderItemId            String?      @map("order_item_id") @db.Char(36)
  refundId               String?      @map("refund_id") @db.Char(36)
  lineType               TaxLineType  @default(ITEM) @map("line_type")
  component              TaxComponent
  supplyType             SupplyType   @map("supply_type")
  placeOfSupplyStateCode String       @map("place_of_supply_state_code") @db.Char(2)
  hsnCode                String       @map("hsn_code") @db.VarChar(8)
  taxableValue           Decimal      @map("taxable_value") @db.Decimal(12, 2)
  rate                   Decimal      @db.Decimal(5, 2)
  amount                 Decimal      @db.Decimal(12, 2)
  taxDate                DateTime     @map("tax_date") @db.Date
  financialYear          String       @map("financial_year") @db.VarChar(9)
  createdAt              DateTime     @default(now()) @map("created_at") @db.DateTime(3)

  invoiceRecord InvoiceRecord @relation(fields: [invoiceRecordId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderItem     OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund        Refund?       @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  posState      State         @relation("TaxPOSState", fields: [placeOfSupplyStateCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([invoiceRecordId], map: "ix_tax_txn_invoice")
  @@index([orderId], map: "ix_tax_txn_order")
  @@index([taxDate, financialYear], map: "ix_tax_txn_date_fy")
  @@map("tax_transactions")
}

// 58 invoice_records
model InvoiceRecord {
  id                     String      @id @default(uuid()) @db.Char(36)
  invoiceType            InvoiceType @map("invoice_type")
  invoiceNumber          String      @unique @map("invoice_number") @db.VarChar(30)
  financialYear          String      @map("financial_year") @db.VarChar(9)
  sequenceNo             Int         @map("sequence_no")
  orderId                String      @map("order_id") @db.Char(36)
  shipmentId             String?     @map("shipment_id") @db.Char(36)
  refundId               String?     @map("refund_id") @db.Char(36)
  originalInvoiceId      String?     @map("original_invoice_id") @db.Char(36)
  invoiceDate            DateTime    @map("invoice_date") @db.Date
  sellerGstin            String?     @map("seller_gstin") @db.VarChar(15)
  sellerStateCode        String      @map("seller_state_code") @db.Char(2)
  buyerGstin             String?     @map("buyer_gstin") @db.VarChar(15)
  placeOfSupplyStateCode String      @map("place_of_supply_state_code") @db.Char(2)
  supplyType             SupplyType  @map("supply_type")
  taxableTotal           Decimal     @map("taxable_total") @db.Decimal(12, 2)
  taxTotal               Decimal     @map("tax_total") @db.Decimal(12, 2)
  grandTotal             Decimal     @map("grand_total") @db.Decimal(12, 2)
  pdfStorageKey          String?     @map("pdf_storage_key") @db.VarChar(255)
  createdAt              DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shipment        Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  refund          Refund?          @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  originalInvoice InvoiceRecord?   @relation("InvoiceOriginal", fields: [originalInvoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  creditNotes     InvoiceRecord[]  @relation("InvoiceOriginal")
  sellerState     State            @relation("InvoiceSellerState", fields: [sellerStateCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  posState        State            @relation("InvoicePOSState", fields: [placeOfSupplyStateCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  taxTransactions TaxTransaction[]

  @@unique([financialYear, invoiceType, sequenceNo], map: "uq_invoice_fy_type_seq")
  @@index([orderId], map: "ix_invoice_order")
  @@map("invoice_records")
}

// 59 states
