// 31 orders
model Order {
  id                         String        @id @default(uuid()) @db.Char(36)
  orderNumber                String        @unique @map("order_number") @db.VarChar(20)
  userId                     String        @map("user_id") @db.Char(36)
  status                     OrderStatus
  paymentMethod              PaymentMethod @map("payment_method")
  paymentStatus              PaymentStatus @map("payment_status")
  currency                   String        @default("INR") @db.Char(3)
  itemCount                  Int           @map("item_count")
  totalQuantity              Int           @map("total_quantity")
  subtotal                   Decimal       @db.Decimal(12, 2)
  itemDiscountTotal          Decimal       @default(0) @map("item_discount_total") @db.Decimal(12, 2)
  couponDiscountTotal        Decimal       @default(0) @map("coupon_discount_total") @db.Decimal(12, 2)
  shippingCharge             Decimal       @default(0) @map("shipping_charge") @db.Decimal(12, 2)
  shippingDiscount           Decimal       @default(0) @map("shipping_discount") @db.Decimal(12, 2)
  codCharge                  Decimal       @default(0) @map("cod_charge") @db.Decimal(12, 2)
  taxableTotal               Decimal       @map("taxable_total") @db.Decimal(12, 2)
  cgstTotal                  Decimal       @default(0) @map("cgst_total") @db.Decimal(12, 2)
  sgstTotal                  Decimal       @default(0) @map("sgst_total") @db.Decimal(12, 2)
  utgstTotal                 Decimal       @default(0) @map("utgst_total") @db.Decimal(12, 2)
  igstTotal                  Decimal       @default(0) @map("igst_total") @db.Decimal(12, 2)
  taxTotal                   Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  roundOff                   Decimal       @default(0) @map("round_off") @db.Decimal(12, 2)
  grandTotal                 Decimal       @map("grand_total") @db.Decimal(12, 2)
  refundedTotal              Decimal       @default(0) @map("refunded_total") @db.Decimal(12, 2)
  pricesIncludeTax           Boolean       @map("prices_include_tax")
  couponId                   String?       @map("coupon_id") @db.Char(36)
  couponCodeSnapshot         String?       @map("coupon_code_snapshot") @db.VarChar(32)
  shippingMethodId           String?       @map("shipping_method_id") @db.Char(36)
  shippingMethodNameSnapshot String?       @map("shipping_method_name_snapshot") @db.VarChar(100)
  supplyType                 SupplyType    @map("supply_type")
  placeOfSupplyStateCode     String        @map("place_of_supply_state_code") @db.Char(2)
  sellerGstinSnapshot        String?       @map("seller_gstin_snapshot") @db.VarChar(15)
  sellerStateCodeSnapshot    String        @map("seller_state_code_snapshot") @db.Char(2)
  buyerGstin                 String?       @map("buyer_gstin") @db.VarChar(15)
  buyerLegalName             String?       @map("buyer_legal_name") @db.VarChar(150)
  customerNameSnapshot       String        @map("customer_name_snapshot") @db.VarChar(160)
  customerEmailSnapshot      String        @map("customer_email_snapshot") @db.VarChar(254)
  customerPhoneSnapshot      String?       @map("customer_phone_snapshot") @db.VarChar(16)
  billingAddressSnapshot     Json          @map("billing_address_snapshot")
  shippingAddressSnapshot    Json          @map("shipping_address_snapshot")
  pricingContext             Json          @map("pricing_context")
  customerNote               String?       @map("customer_note") @db.VarChar(500)
  reservationExpiresAt       DateTime?     @map("reservation_expires_at") @db.DateTime(3)
  placedAt                   DateTime      @default(now()) @map("placed_at") @db.DateTime(3)
  confirmedAt                DateTime?     @map("confirmed_at") @db.DateTime(3)
  shippedAt                  DateTime?     @map("shipped_at") @db.DateTime(3)
  deliveredAt                DateTime?     @map("delivered_at") @db.DateTime(3)
  cancellationRequestedAt    DateTime?     @map("cancellation_requested_at") @db.DateTime(3)
  cancelledAt                DateTime?     @map("cancelled_at") @db.DateTime(3)
  cancelledById              String?       @map("cancelled_by_id") @db.Char(36)
  cancellationReason         String?       @map("cancellation_reason") @db.VarChar(500)
  ipAddress                  String?       @map("ip_address") @db.VarChar(45)
  userAgent                  String?       @map("user_agent") @db.VarChar(255)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  user               User                   @relation("OrderCustomer", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  coupon             Coupon?                @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  shippingMethod     ShippingMethod?        @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  placeOfSupplyState State                  @relation("OrderPOSState", fields: [placeOfSupplyStateCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  sellerState        State                  @relation("OrderSellerState", fields: [sellerStateCodeSnapshot], references: [code], onDelete: Restrict, onUpdate: Restrict)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  refunds            Refund[]
  shipments          Shipment[]
  reservations       StockReservation[]
  invoiceRecords     InvoiceRecord[]
  taxTransactions    TaxTransaction[]
  couponUsage        CouponUsage?
  inventoryTxns      InventoryTransaction[]
  convertedFromCart  Cart[]                 @relation("ConvertedOrder")

  @@index([userId, placedAt], map: "ix_orders_user_placed")
  @@index([status, placedAt], map: "ix_orders_status_placed")
  @@index([paymentStatus, placedAt], map: "ix_orders_payment_status")
  @@index([confirmedAt, status], map: "ix_orders_confirmed")
  @@index([placeOfSupplyStateCode, confirmedAt], map: "ix_orders_pos_confirmed")
  @@index([status, reservationExpiresAt], map: "ix_orders_reservation")
  @@map("orders")
}

