generator client {
  provider = "prisma-client" // Prisma 7 default generator (output path is required)
  output   = "../src/generated/prisma" // generated TypeScript client, not committed
}

datasource db {
  provider = "mysql"
  // relationMode = "foreignKeys" (default)
  // Connection URL: prisma.config.ts (CLI) and the driver adapter (runtime) — not in the schema.
}

