# ecommerce-api — environment variables (local development example)
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Never commit real values. Staging/production values come from the
# hosting secret manager (OQ-34), not from files.
#
# Only variables used by the current code are listed. Later increments add their variables
# (DATABASE_URL, REDIS_URL, JWT_*, CLOUDINARY_*, …) here, in src/core/config/env.ts and in
# REPOSITORY_SETUP_GUIDE.md §9.1 in the same change.

# ── Core ─────────────────────────────────────────────────────────────────────────────
# development | test | staging | production
NODE_ENV=development
APP_NAME=[BRAND_NAME] API
PORT=4000
# Business timezone for reports/invoices (must be Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
# Process timezone — all timestamps are stored in UTC (must be UTC)
TZ=UTC

# ── Database (Prisma / MySQL) ────────────────────────────────────────────────────────
# Placeholder only — never a real credential. No database connection is made in B0-b Part 1.
# Prisma 7 reads this via prisma.config.ts (CLI) and the runtime client will use the driver
# adapter with the validated config in a later increment.
DATABASE_URL="mysql://user:password@localhost:3306/ecommerce_dev"

# ── Public URLs (https required in staging/production) ─────────────────────────────
API_BASE_URL=http://localhost:4000
STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ── Logging ──────────────────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Human-readable logs; development only (rejected in staging/production)
LOG_PRETTY=true

# ── HTTP & security ──────────────────────────────────────────────────────────────────
# Number of reverse-proxy hops in front of the API (0 locally, 1 behind a load balancer)
TRUST_PROXY=0
# Default JSON body limit; bulk routes raise it per route
REQUEST_BODY_LIMIT=100kb
# Exact allowed origins, comma-separated, no wildcards. /api/v1/admin/* also requires ADMIN_URL's origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# General per-IP limit on /api/v1. IN-MEMORY: valid for a single local instance only, NOT for
# multi-instance production (counters are per instance). Redis is deferred (D-38 / OQ-35).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=300

# ── Background jobs ─────────────────────────────────────────────────────────────────
# In-process scheduler (reservation expiry, unpaid-order cancel, notification dispatch, token cleanup).
# SINGLE INSTANCE ONLY (no distributed lock until Redis/BullMQ, D-38 / OQ-35). Off by default.
JOBS_ENABLED=false
